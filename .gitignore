# Kubernetes kubeconfigs (sensitive — never commit)
infra/*-kubeconfig.yaml

# Generated Go proto stubs (rebuilt by CI / gen-proto-go.sh)
go-services/gateway/internal/enginepb/*.go

# Local artefacts not for the repo
*.docx
*.pdf
build/
