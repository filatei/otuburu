[Unit]
Description=Otuburu Demo (synthetic brokerage)
Documentation=https://github.com/torama/otuburu
After=network.target

[Service]
Type=simple
User=otuburu
Group=otuburu
WorkingDirectory=/home/otuburu/app
ExecStart=/usr/bin/node engine/server.js
Environment=PORT=8080
Environment=NODE_ENV=production
Restart=always
RestartSec=3
StandardOutput=append:/home/otuburu/logs/otuburu.log
StandardError=append:/home/otuburu/logs/otuburu.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
