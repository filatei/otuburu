FROM golang:1.25-bookworm AS builder

# We don't commit go.sum (yet), so the Dockerfile runs `go mod tidy` each
# build — which means transitive deps drift to whatever's latest. A retail
# transitive dep (github.com/rogpeppe/go-internal v1.15.0+) now requires
# Go 1.25, so the builder image is pinned to that. Follow-up: commit
# go.sum and switch the RUN below to `go mod download` for reproducible
# builds.

WORKDIR /build
COPY go-services/wallet/ go-services/wallet/

WORKDIR /build/go-services/wallet
RUN go mod tidy \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /otuburu-wallet ./cmd

# debian:12-slim instead of distroless so healthcheck (nc) works inside the container.
FROM debian:12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /otuburu-wallet /otuburu-wallet

ENV PORT=8083 \
    GIN_MODE=release

EXPOSE 8083
ENTRYPOINT ["/otuburu-wallet"]
