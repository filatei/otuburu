# Force legacy peer-dependency resolution for the whole web/ project.
#
# Why: @codetrix-studio/capacitor-google-auth declares peer
# @capacitor/core@^6.0.0 but we're on Capacitor 8. The plugin's actual
# Plugin API surface (Capacitor.Plugins, registerPlugin) is stable
# across Cap 6/7/8, so the conflict is a peer-dep declaration issue,
# not a runtime one. Forcing legacy resolution is the standard
# workaround until the plugin author bumps the declared peer range.
#
# Without this, `npm ci` in CI errors with ERESOLVE while local
# `npm install --legacy-peer-deps` works — confusing inconsistency.
# Setting it here makes both behave the same way.
#
# Revisit when the plugin ships a version with @capacitor/core@^8 in
# its peer deps, or when we switch to a better-maintained alternative
# like @capgo/capacitor-social-login.
legacy-peer-deps=true
